{
  "name": "sunhavenmod-site-tools",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "sync-mod-matrix": "node scripts/matrix/sync-docs-mod-matrix.js",
    "stats": "node scripts/stats/fetch-stats.js",
    "stats:force": "node scripts/stats/fetch-stats.js --force",
    "verify-versions": "python scripts/version/verify-version-consistency.py",
    "cf:site:install": "npm --prefix cloudflare-site install",
    "cf:site:dev": "npm --prefix cloudflare-site run dev",
    "cf:site:build": "npm --prefix cloudflare-site run build",
    "cf:pages:dev": "npm run cf:site:build && npx wrangler pages dev --project-name azrael-sunhaven-website",
    "cf:pages:deploy": "npm run cf:site:build && npx wrangler pages deploy --project-name azrael-sunhaven-website"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
