# Repo-wide ignores

# Decompiled source code - do not upload
Decompiled/
Decomplied/
Decompiled/
# Per-mod local dnSpy/ILSpy dumps (never commit game-derived source)
HavensAlmanac/_refs/*_decompiled.cs
HavensAlmanac/_refs/Inventory_decompiled.cs

# Build results
[Dd]ebug/
[Rr]elease/
bin/
obj/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet packages
packages/
*.nupkg

# Build artifacts
*.dll
*.pdb
*.exe

# Local/CI staging outputs (workflows recreate these each run)
builds/

# Local secrets for tooling
.env

# Local script run logs (never commit ad hoc transcripts)
*.log

# Community mods — local builds, not in mod-matrix / release pipeline
CommunityMods/UltraPolygamy/
