<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>HavensAlmanac</AssemblyName>
    <RootNamespace>HavensAlmanac</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CS0436: We compile SharedUtilities and reference other mods (BirthdayReminder, etc.); those DLLs also embed VersionChecker/ReflectionHelper. We use our copy. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!-- BepInEx References -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity References -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedPath)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game References -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Soft Dependencies: All 7 mods (optional integration) -->
  <ItemGroup>
    <Reference Include="SunhavenTodo">
      <HintPath>..\builds\SunhavenTodo\SunhavenTodo.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BirthdayReminder">
      <HintPath>..\builds\BirthdayReminder\BirthdayReminder.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SunHavenMuseumUtilityTracker">
      <HintPath>..\builds\SunHavenMuseumUtilityTracker\SunHavenMuseumUtilityTracker.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SenpaisChest">
      <HintPath>..\builds\SenpaisChest\SenpaisChest.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TheVault">
      <HintPath>..\builds\TheVault\TheVault.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HavensBirthright">
      <HintPath>..\builds\HavensBirthright\HavensBirthright.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HavenDevTools">
      <HintPath>..\builds\HavenDevTools\HavenDevTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CropOptimizer">
      <HintPath>..\builds\CropOptimizer\CropOptimizer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude decompiled reference files -->
  <ItemGroup>
    <Compile Remove="Inventory_decompiled.cs" />
  </ItemGroup>

  <!-- Shared Utilities (linked files) -->
  <ItemGroup>
    <Compile Include="..\SharedUtilities\ConfigFileHelper.cs" Link="Shared\ConfigFileHelper.cs" />
    <Compile Include="..\SharedUtilities\OvernightHookUtility.cs" Link="Shared\OvernightHookUtility.cs" />
    <Compile Include="..\SharedUtilities\VersionChecker.cs" Link="Shared\VersionChecker.cs" />
    <Compile Include="..\SharedUtilities\SceneRootSurvivor.cs" Link="Shared\SceneRootSurvivor.cs" />
    <Compile Include="..\SharedUtilities\ReflectionHelper.cs" Link="Shared\ReflectionHelper.cs" />
    <Compile Include="..\SharedUtilities\GUIStyleHelper.cs" Link="Shared\GUIStyleHelper.cs" />
    <Compile Include="..\SharedUtilities\TextInputFocusGuard.cs" Link="Shared\TextInputFocusGuard.cs" />
  </ItemGroup>

  <!-- Copy to BepInEx plugins folder and builds folder after build -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPath)\plugins\HavensAlmanac" Condition="'$(SunhavenCopyToBepInExPlugins)' == 'true'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\builds\HavensAlmanac" />
    <Message Text="Copied $(TargetFileName) to BepInEx plugins and builds folder" Importance="High" />
  </Target>

</Project>
